DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGINS=["http://localhost:3000","http://localhost:4200","http://localhost:5173"]

MAX_CONCURRENT_RUNS=2
STREAM_POLL_S=1.0

LIMIT_MAX_DRONES=10
LIMIT_MAX_POINTS=30
# LIMIT_MAX_POPULATION=
# LIMIT_MAX_GENERATIONS=
LIMIT_MAX_GRID_CELLS=40000

DEFAULT_N_DRONES=3
DEFAULT_N_POINTS=8
DEFAULT_POPULATION_SIZE=100
DEFAULT_GENERATIONS=100
DEFAULT_CROSSOVER_PROB=0.9
DEFAULT_CROSSOVER_ETA=15
DEFAULT_MUTATION_SIGMA=0.05
RANDOM_BASELINE_FACTOR=1.0

BATTERY_RESERVE=0.15
MIN_SEPARATION_M=10
BASE_CLEARANCE_M=50
SEPARATION_SAMPLING_S=2
SEPARATION_MAX_SAMPLES=4000

VISIBILITY_OPEN=0.95
VISIBILITY_BRUSH=0.70
VISIBILITY_DENSE=0.45

PRIORITY_SIGMA_M=200
PRIORITY_PATH_WEIGHT=0.5
PRIORITY_PATH_WIDTH_M=30
